        <di:waypoint x="515" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="633" y="175"/>
        <di:waypoint x="649" y="175"/>
