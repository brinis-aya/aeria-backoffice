        <di:waypoint x="1265" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
        <di:waypoint x="1383" y="190"/>
        <di:waypoint x="1456" y="190"/>
