<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_deploiement_capteur" targetNamespace="https://github.com/brinis-aya/aeria-backoffice" exporter="aeria scripts/diagrams.py" exporterVersion="1.0">
  <bpmn:collaboration id="collab_deploiement_capteur">
    <bpmn:participant id="pool_deploiement_capteur" name="Déploiement d'un nouveau capteur" processRef="deploiement_capteur"/>
  </bpmn:collaboration>
  <bpmn:process id="deploiement_capteur" name="Déploiement d'un nouveau capteur" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_resp" name="Responsable maintenance">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_site</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mag" name="Magasin">
        <bpmn:flowNodeRef>g_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_tech" name="Technicien">
        <bpmn:flowNodeRef>t_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_diag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Système">
        <bpmn:flowNodeRef>t_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_data</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Nouveau point de mesure décidé">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_site" name="Choisir et créer le site (zone, environnement)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_stock" name="Capteur en stock ?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_order" name="Commander un capteur">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_merge" name="">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_prep" name="Préparer : firmware, identifiants MQTT, ACL">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_pose" name="Poser le capteur (RG1, RG2)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="t_record" name="Enregistrer l'installation (statut « en service »)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_check" name="Vérifier 24 h de mesures reçues">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_data" name="Données valides ?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_diag" name="Diagnostiquer sur site">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_ok" name="Capteur en service">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_site"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t_site" targetRef="g_stock"/>
    <bpmn:sequenceFlow id="f3" sourceRef="g_stock" targetRef="t_order" name="non"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g_stock" targetRef="g_merge" name="oui"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t_order" targetRef="g_merge"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g_merge" targetRef="t_prep"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t_prep" targetRef="t_pose"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t_pose" targetRef="t_record"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t_record" targetRef="t_check"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t_check" targetRef="g_data"/>
    <bpmn:sequenceFlow id="f11" sourceRef="g_data" targetRef="end_ok" name="oui"/>
    <bpmn:sequenceFlow id="f12" sourceRef="g_data" targetRef="t_diag" name="non"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t_diag" targetRef="t_pose"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_deploiement_capteur">
    <bpmndi:BPMNPlane id="plane_deploiement_capteur" bpmnElement="collab_deploiement_capteur">
      <bpmndi:BPMNShape id="pool_deploiement_capteur_di" bpmnElement="pool_deploiement_capteur" isHorizontal="true"><dc:Bounds x="20" y="60" width="1789.0" height="680"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_resp_di" bpmnElement="lane_resp" isHorizontal="true"><dc:Bounds x="54" y="60" width="1755.0" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_mag_di" bpmnElement="lane_mag" isHorizontal="true"><dc:Bounds x="54" y="230" width="1755.0" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_tech_di" bpmnElement="lane_tech" isHorizontal="true"><dc:Bounds x="54" y="400" width="1755.0" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_sys_di" bpmnElement="lane_sys" isHorizontal="true"><dc:Bounds x="54" y="570" width="1755.0" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="106" y="127" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_site_di" bpmnElement="t_site"><dc:Bounds x="215" y="113" width="118" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_stock_di" bpmnElement="g_stock" isMarkerVisible="true"><dc:Bounds x="401" y="292" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_order_di" bpmnElement="t_order"><dc:Bounds x="515" y="243" width="118" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_merge_di" bpmnElement="g_merge" isMarkerVisible="true"><dc:Bounds x="701" y="292" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_prep_di" bpmnElement="t_prep"><dc:Bounds x="815" y="453" width="118" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_pose_di" bpmnElement="t_pose"><dc:Bounds x="965" y="453" width="118" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_record_di" bpmnElement="t_record"><dc:Bounds x="1115" y="623" width="118" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_check_di" bpmnElement="t_check"><dc:Bounds x="1265" y="623" width="118" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_data_di" bpmnElement="g_data" isMarkerVisible="true"><dc:Bounds x="1451" y="632" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_diag_di" bpmnElement="t_diag"><dc:Bounds x="1565" y="473" width="118" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="1681" y="127" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="142" y="145"/>
        <di:waypoint x="215" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="333" y="145"/>
        <di:waypoint x="367" y="145"/>
        <di:waypoint x="367" y="315"/>
        <di:waypoint x="401" y="315"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="424" y="292"/>
        <di:waypoint x="424" y="275"/>
        <di:waypoint x="515" y="275"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="447" y="315"/>
        <di:waypoint x="701" y="315"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="633" y="275"/>
        <di:waypoint x="667" y="275"/>
        <di:waypoint x="667" y="315"/>
        <di:waypoint x="701" y="315"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="724" y="338"/>
        <di:waypoint x="724" y="485"/>
        <di:waypoint x="815" y="485"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="933" y="485"/>
        <di:waypoint x="965" y="485"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="1083" y="485"/>
        <di:waypoint x="1099" y="485"/>
        <di:waypoint x="1099" y="655"/>
        <di:waypoint x="1115" y="655"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="1233" y="655"/>
        <di:waypoint x="1265" y="655"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10">
        <di:waypoint x="1383" y="655"/>
        <di:waypoint x="1451" y="655"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
        <di:waypoint x="1474" y="632"/>
        <di:waypoint x="1474" y="145"/>
        <di:waypoint x="1681" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12">
        <di:waypoint x="1497" y="655"/>
        <di:waypoint x="1531" y="655"/>
        <di:waypoint x="1531" y="505"/>
        <di:waypoint x="1565" y="505"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13">
        <di:waypoint x="1624" y="537"/>
        <di:waypoint x="1624" y="567"/>
        <di:waypoint x="1024" y="567"/>
        <di:waypoint x="1024" y="517"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>